# Ambientes virtuais
.venv/
venv/

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.testmondata*
.coverage
htmlcov/

# Ferramentas e editores
.idea/
.vscode/
.ruff_cache/
.mypy_cache/

# Fragmentos temporarios criados durante transferencias de arquivos
.tmp.driveupload/

# Configuracoes e segredos locais
.env
.env.*
.streamlit/secrets.toml

# Dados locais: preservar somente a estrutura de diretorios
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Demandas orcamentarias submetidas pelo app (dado real de producao, nao
# versionado — ver data/referencia/ para as listas de apoio, essas sim versionadas)
data/demandas/*
!data/demandas/.gitkeep

# Banco SQLite da Captacao de Demandas (dado real de producao, gerado pelo app — ver
# src/captacao/schema.py), nao versionado.
data/captacao/*
!data/captacao/.gitkeep

# Emendas parlamentares cadastradas pelo app (mesmo motivo de data/demandas/ acima)
data/emendas/*
!data/emendas/.gitkeep

# Prazos orcamentarios cadastrados manualmente pelo app (mesmo motivo de data/demandas/ acima)
data/prazos_orcamentarios/*
!data/prazos_orcamentarios/.gitkeep

# Cadastro nativo de Bolsas e Auxilios / Contratos Continuos, multi-exercicio (mesmo motivo
# de data/demandas/ acima) - substitui a leitura de planilha dessas duas paginas.
data/bolsas_auxilios/*
!data/bolsas_auxilios/.gitkeep
data/contratos_continuos/*
!data/contratos_continuos/.gitkeep

# Banco SQLite do modulo de TEDs (data real de producao, gerado pelos uploads da propria
# pagina app_pages/teds.py — ver docstring de src/teds_schema.py), nao versionado.
data/teds/*
!data/teds/.gitkeep

# Fracao liberada do Limite de Empenho, editada manualmente pelo usuario e persistida em
# disco a pedido dele (mesmo motivo de data/demandas/ acima) — ver
# src/limite_empenho_preferencias.py.
data/limite_empenho/*
!data/limite_empenho/.gitkeep

# Cadastro editavel do Glossario (verbetes incluidos/editados pelo app; a base fixa continua em
# src/glossario.py) — ver src/glossario_cadastro.py.
data/glossario/*
!data/glossario/.gitkeep

# Integracao com o Google Agenda: credenciais do cliente OAuth, token de acesso e resumo da
# ultima sincronizacao (segredo local, nunca versionado) - ver src/google_agenda.py.
data/google_agenda/*
!data/google_agenda/.gitkeep

# Copias dos arquivos substituidos por uma restauracao de backup — ver src/backup_dados.py.
data/_backup_restauracao/
data/.restauracao-*/

# Sistema operacional
.DS_Store
Thumbs.db

# Logs soltos (ex.: saída de smoke test)
*.log

# Configuracoes locais do Claude Code (permissoes por maquina, nao de projeto)
.claude/settings.local.json

# Screenshots soltos na raiz sem relacao clara com o codigo atual
inbox_*.png
