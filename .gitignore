# Ambientes virtuais
.venv/
venv/

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# Ferramentas e editores
.idea/
.vscode/
.ruff_cache/
.mypy_cache/

# Configuracoes e segredos locais
.env
.env.*
