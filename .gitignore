# Dados locais: preservar somente a estrutura de diretorios
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Sistema operacional
.DS_Store
Thumbs.db

# Logs soltos (ex.: saída de smoke test)
*.log
